# Supabase — dal dashboard: Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Sviluppo browser (npm run dev:browser) — già in .env.development
# VITE_BRANCHEFY_WEB=1

# Legacy (opzionale, se usi ancora la anon key JWT):
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Pagina invito / download (default: https://download-branchefy.vercel.app/)
# VITE_DOWNLOAD_PAGE_URL=https://download-branchefy.vercel.app/

# Donate (default: PayPal.me in codice)
# VITE_SUPPORT_DONATE_URL=https://paypal.me/Cotechinoh

# --- Produzione web (Vercel) ---
# BRANCHEFY_API_URL=https://progetto-infanzia-production.up.railway.app
# VITE_BRANCHEFY_API_URL=https://progetto-infanzia-production.up.railway.app
# SUPABASE_SERVICE_ROLE_KEY=...   # solo server: ban IP / access-ip

# --- API Rust (Railway / locale) ---
# BRANCHEFY_DATA_DIR=/data
# BRANCHEFY_PUBLIC_URL=https://progetto-infanzia-production.up.railway.app
# PORT=8787

# Mediaset Infinity — account dedicato (solo lato server / .env locale, MAI in git)
# Se impostati, l'API usa Gigya + idm/account/login al posto del solo guest.
# MEDIASET_LOGIN_ID=tua-email@example.com
# MEDIASET_PASSWORD=tua-password-account
